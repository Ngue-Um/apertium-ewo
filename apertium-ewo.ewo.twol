Alphabet
A B D DZ E È Ë F G GB H I K KP L M N NY Ṅ P R S T TS U V W Y Z
a b d dz e è ë f g gb h i k kp l m n ny ṅ p r s t ts u v w y z
ë ṅ


 %>:0
 %{ë%}:ë %{ë%}:0
 %{E%}:e %{I%}:y
 %{A%}:a %>:%>  
 %{N%}:n %{N%}:m %{N%}:ṅ
;

Sets
Vowels = A E È Ë I O Ò U
        a e è ë i o ò u ;
FrontVows = e i ;
Labials = b p ;
Alveolars = t d l s z ;
Palatals = y ;
Velars = k g ;

Rules
"Remove morpheme boundary"
%>:0 <=> _ ;

"Remove suffix vowel with vowel-ending stem"
i:0 <=> Vow %{VSUF%}:0 _ [ m | n ] ;

"Delete prefix vowel at morpheme boundary before roots begining in a vowel"
%{ë%}:0 <=> [ b | m ] _ %>: :Vowels ;

! %{E%}:y <=> %>: _ Vows %{VSUF%}:e ;

"{N} to /ng/"
%{N%}:ṅ <=> _ %>: :Velars ;

"{N} to /n/"
%{N%}:n <=> n _ %>: :Alveolars ;

